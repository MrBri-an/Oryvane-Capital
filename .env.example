# Safe to expose to browser code. Obtain these from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never prefix server-only secrets with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY is intentionally not required in Phase 2.

# Server-only payment destinations. Leave an entire method blank to show it as unavailable.
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_CURRENCY=
PAYMENT_BITCOIN_ADDRESS=
PAYMENT_BITCOIN_NETWORK=

# Server-only receipt scanner. Production receipt review remains blocked when unset.
RECEIPT_SCANNER_URL=
RECEIPT_SCANNER_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-time first-administrator web setup. Server-only; remove after bootstrap.
INITIAL_SUPER_ADMIN_EMAIL=
ADMIN_SETUP_TOKEN=

# Optional disposable staging accounts used only by authenticated Playwright tests.
STAGING_USER_EMAIL=
STAGING_USER_PASSWORD=
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
STAGING_ADMIN_TOTP_CODE=
STAGING_REGISTRATION_EMAIL=
STAGING_REGISTRATION_PASSWORD=
